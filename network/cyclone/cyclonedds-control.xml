<CycloneDDS>
  <Domain Id="any">

    <General>
      <Interfaces>
        <!-- WireGuard interface (experimental, commented out) -->
        <!-- <NetworkInterface name="wg0" address="10.0.0.1" priority="100" multicast="false"/> -->

        <!-- Robot/server LAN interface: replace eno2 with the actual interface name -->
        <NetworkInterface name="eno2" address="10.24.15.102" priority="100" multicast="true"/>
      </Interfaces>

      <!-- Allow multicast only where the interface allows it.
           wg0 has multicast=false above, LAN has multicast=true. -->
      <AllowMulticast>true</AllowMulticast>
    </General>

    <Discovery>
      <Peers>
        <!-- WireGuard client (experimental, commented out) -->
        <!-- <Peer Address="10.0.0.10"/> -->

        <!-- Robot LAN machines -->
        <Peer Address="10.24.15.100"/>
        <Peer Address="10.24.15.101"/>
        <Peer Address="10.24.15.102"/>
      </Peers>
    </Discovery>

  </Domain>
</CycloneDDS>