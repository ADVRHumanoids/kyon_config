      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Power",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "afu9xn6p4581sc"
                      },
                      "spec": {
                        "query": "from(bucket: \"diagnostics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) =>\n    (r._measurement == \"vbatt\" or r._measurement == \"iload\") and\n    r._field == \"min\"\n  )\n  |> filter(fn: (r) => r._value != 0.0)\n  |> keep(columns: [\"_time\", \"_value\", \"_measurement\"])\n  |> aggregateWindow(every: 1s, fn: min, createEmpty: false)\n  |> group()\n  |> pivot(\n    rowKey: [\"_time\"],\n    columnKey: [\"_measurement\"],\n    valueColumn: \"_value\"\n  )\n  |> filter(fn: (r) => exists r.vbatt and exists r.iload)\n  |> map(fn: (r) => ({\n    _time: r._time,\n    _value: r.vbatt * r.iload,\n    _measurement: \"power\"\n  }))\n  |> group(columns: [\"_measurement\"])\n  |> ${Reduction:raw}()\n  |> group()\n"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
